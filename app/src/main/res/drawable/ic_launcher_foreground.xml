<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled down and pivoted on the viewport center so the whole mark sits inside the
         ~66dp "safe zone" every adaptive-icon mask shape (circle, squircle, rounded square)
         guarantees won't be clipped — the un-scaled shape's legs/corners reached past it. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.68"
        android:scaleY="0.68">
        <!-- TV legs -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFB000"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M32,74 L24,86" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFB000"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M76,74 L84,86" />
        <!-- TV body: bold rounded-rect outline, no fill so the near-black background shows through -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFB000"
            android:strokeWidth="5.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M28,30 L80,30 A8,8 0 0 1 88,38 L88,66 A8,8 0 0 1 80,74 L28,74 A8,8 0 0 1 20,66 L20,38 A8,8 0 0 1 28,30 Z" />
        <!-- Cyan play/signal triangle: the focal shape inside the screen -->
        <path
            android:fillColor="#4FD8E0"
            android:pathData="M45,43 L45,61 L65,52 Z" />
    </group>
</vector>
